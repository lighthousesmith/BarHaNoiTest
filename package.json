{
  "name": "ha-noi-asian-food",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck:app": "tsc -p tsconfig.app.json --noEmit",
    "test:delivery-estimate": "tsx --test src/utils/deliveryEstimate.test.ts",
    "test:ordering-times": "tsx --test src/utils/orderingTimes.test.ts",
    "test:customer-errors": "tsx --test src/utils/customerErrors.test.ts",
    "test:pos-totals": "tsx --test convex/lib/dotykackaKitchenPayload.test.ts",
    "test:admin-auth": "node scripts/test-admin-orders-auth.mjs && node scripts/test-user-sync-auth.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "wrangler:preview": "npm run build && wrangler dev",
    "test:order-security": "node --test tests/*.test.mjs && tsx --test src/utils/loyaltyAmount.test.ts",
    "test:scanner": "node tests/browser/scanner.mjs",
    "test:card-entry": "node tests/browser/card-entry.mjs",
    "preview:ha-noi-card": "node scripts/preview-ha-noi-card.mjs",
    "test:loyalty-flow": "node tests/browser/loyalty-flow.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@clerk/clerk-react": "^5.0.0",
    "@clerk/localizations": "^4.15.5",
    "@radix-ui/react-slot": "^1.3.0",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "2.1.1",
    "convex": "^1.17.0",
    "framer-motion": "^12.38.0",
    "jsqr": "1.4.0",
    "lucide-react": "latest",
    "qrcode.react": "^4.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "3.4.0"
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "^22.0.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "5.1.1",
    "playwright": "1.57.0",
    "tailwindcss": "4.1.17",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vite": "^7.3.2",
    "vite-plugin-mkcert": "^2.0.0",
    "wrangler": "^4.87.0"
  }
}
