# Ha Noi Asian Food website
# Copy this file to .env.local for Vite and convex/.env.local for Convex.
# Keep real secrets out of Git.

# Frontend (.env.local)
VITE_CLERK_PUBLISHABLE_KEY=
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=
VITE_APP_URL=http://localhost:5173
VITE_ENABLE_PAYMENT_TEST=true

# Cloudflare Workers deploy (wrangler)
# Local deploy uses `npx wrangler login`. For CI, set CLOUDFLARE_API_TOKEN instead.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Convex project
CONVEX_DEPLOYMENT=
CONVEX_SITE_URL=
APP_URL=http://localhost:5173

# Clerk auth for Convex
CLERK_SECRET_KEY=
CLERK_ISSUER_URL=
CLERK_JWT_ISSUER_DOMAIN=

# ─── Cloudflare R2 Storage (Media Library) ──────────────────────────────────
# Stores uploaded photos in R2 object storage (preventing 1MB DB document limit).
# Auto-fallback: When unset, Convex built-in storage is used automatically.
# Cloudflare Dashboard → R2 Object Storage → Create Bucket (e.g. barhanoi-media)
# R2 → Manage R2 API Tokens → Create API Token (Object Read & Write):
R2_ACCOUNT_ID=8828c0c4765ceb41f86f1f8dda122643
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=barhanoi-media
R2_PUBLIC_URL=

# Ha Noi Asian Food defaults
RESTAURANT_NAME=Ha Noi Bar
RESTAURANT_CONTACT_EMAIL=daoanhthao82@gmail.com
RESTAURANT_ADDRESS=ul. Człuchowska 37, 01-100 Warszawa
RESTAURANT_PHONE=+48579192223
COMPANY_LEGAL_NAME=Duna Anh Thao Dao
COMPANY_NIP=1132932468
COMPANY_REGON=
COMPANY_WEBSITE=https://barhanoi.pl

# Resend email
# Leave RESEND_TEST_MODE=true while you do not have a Resend key.
# In test mode the backend dry-runs email sends and does not call Resend.
RESEND_TEST_MODE=true
RESEND_API_KEY=
RESEND_FROM_EMAIL=Bar Ha Noi <test@barhanoi.local>
RESERVATION_ADMIN_EMAIL=daoanhthao82@gmail.com

# ─── Dotykačka POS ───────────────────────────────────────────────────────────
# Read by Convex only (convex/.env.local). Values below are FORMAT EXAMPLES in
# comments — replace the empty assignment, do not uncomment the example line.
#
# 1) CLIENT_ID + CLIENT_SECRET: Dotykačka Marketplace → your integration → API credentials.
# example: DOTYKACKA_CLIENT_ID=hanoi-web-1042
DOTYKACKA_CLIENT_ID=
# example: DOTYKACKA_CLIENT_SECRET=9f2c7b41ad6e4c0f8b53e1d97a4c6b28
DOTYKACKA_CLIENT_SECRET=
#
# 2) LICENSE_KEY: Dotykačka admin → Cloud → licence. Optional shortcut — lets you press
#    "Wymień licencję" in Admin → Menu → Dotykačka instead of doing the OAuth round trip.
# example: DOTYKACKA_LICENSE_KEY=3f8a1c92-5d47-4b6e-9a10-72c4de8f5b31
DOTYKACKA_LICENSE_KEY=
#
# 3) REFRESH_TOKEN + CLOUD_ID: do NOT type these by hand. Set CLIENT_ID/CLIENT_SECRET first,
#    run `npx convex dev`, then Admin → Menu → Dotykačka → "Połącz przez przeglądarkę".
#    Start OAuth in the admin panel so the callback has a one-time state. After it completes,
#    use "Pobierz token z OAuth" in the admin panel for the environment commands.
# example: DOTYKACKA_REFRESH_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJjbG91ZElkIjoxMjM0NTZ9.sig
DOTYKACKA_REFRESH_TOKEN=
# example: DOTYKACKA_CLOUD_ID=123456
DOTYKACKA_CLOUD_ID=
#
# 4) BRANCH_ID: the branch/tablet that prints the order. Listed by the OAuth callback and by
#    "Szybki test". Long numeric id, not the branch name.
# example: DOTYKACKA_BRANCH_ID=4239485720394857
DOTYKACKA_BRANCH_ID=
#
# 5) Optional POS product ids used as extra order lines. Leave empty to send the line without
#    a POS product id (packaging still appears on the ticket, just unmapped).
# example: DOTYKACKA_BOX_PRODUCT_ID=4239485720399001
DOTYKACKA_BOX_PRODUCT_ID=
# example: DOTYKACKA_BAG_PRODUCT_ID=4239485720399002
DOTYKACKA_BAG_PRODUCT_ID=
# Delivery fee products (Bar Ha Noi: 6 PLN <3 km, 10 PLN 3–5 km). The server
# sends the exact charged amount via Dotykačka `manual-price`.
# example: DOTYKACKA_DELIVERY_PRODUCT_ID_3KM=2291662812833211
DOTYKACKA_DELIVERY_PRODUCT_ID_3KM=
# example: DOTYKACKA_DELIVERY_PRODUCT_ID_5KM=2291662984310183
DOTYKACKA_DELIVERY_PRODUCT_ID_5KM=
# Optional fallback when only one delivery product exists in POS:
# example: DOTYKACKA_DELIVERY_PRODUCT_ID=2291662812833211
DOTYKACKA_DELIVERY_PRODUCT_ID=
#
# 6) TEST_PRODUCT_ID: POS id of a 1 PLN item, used by Admin → Płatności → "Produkt testowy P24".
# example: DOTYKACKA_TEST_PRODUCT_ID=4239485720399003
DOTYKACKA_TEST_PRODUCT_ID=
#
# 7) WEBHOOK_SECRET: you invent this one. Any long random string. Paste the SAME value into the
#    Dotykačka webhook config, either as header x-ha-noi-webhook-secret or as ?secret= in the URL:
#    <CONVEX_SITE_URL>/api/dotykacka/webhook?secret=<this value>
#    Generate one with:  openssl rand -hex 32
# example: DOTYKACKA_WEBHOOK_SECRET=5e1b0c7d94a2f83641bd7ec50a9f2361c8d47b0e6a35f912c4d80e7b136af9a2
DOTYKACKA_WEBHOOK_SECRET=

# ─── Przelewy24 ──────────────────────────────────────────────────────────────
# Read by Convex only. Panel: sandbox https://sandbox-go.przelewy24.pl
#                             live    https://panel.przelewy24.pl
# All four secrets live under Moje dane → Konfiguracja / Klucze API.
#
# MERCHANT_ID: your P24 account number (numeric). Note: the literal value 12345 is treated as a
#              placeholder by convex/p24Helpers.ts and will report "not configured".
# example: P24_MERCHANT_ID=284512
P24_MERCHANT_ID=
#
# POS_ID: almost always identical to MERCHANT_ID. Only differs on multi-shop accounts.
#         Falls back to P24_MERCHANT_ID if left empty.
# example: P24_POS_ID=284512
P24_POS_ID=
#
# CRC_KEY: "Klucz CRC" — 16 hex chars. Sandbox and production have DIFFERENT CRC keys.
#          Used to sign register/verify and to validate the incoming webhook.
# example: P24_CRC_KEY=a1b2c3d4e5f60718
P24_CRC_KEY=
#
# API_KEY: "Klucz do raportów / API" — 32 hex chars. Sent as HTTP Basic password with POS_ID.
# example: P24_API_KEY=9c8b7a6d5e4f30211a2b3c4d5e6f7081
P24_API_KEY=
#
# API_URL: base host only. Must NOT include /api/v1 — the code appends the paths itself.
#          sandbox: https://sandbox.przelewy24.pl   live: https://secure.przelewy24.pl
P24_API_URL=https://sandbox.przelewy24.pl
#
# Register this URL as "URL statusu" in the P24 panel (it is also shown in Admin → Płatności):
#   <CONVEX_SITE_URL>/api/p24/notify
# In production the endpoint only accepts P24's own IP ranges; in sandbox any IP is accepted.
#
# P24_TEST_MODE is currently not read by any code — sandbox vs live is decided by P24_API_URL.
P24_TEST_MODE=true
# ENABLE_PAYMENT_TEST exposes the hidden 1 PLN "Test Płatności" item. Set to false before launch.
ENABLE_PAYMENT_TEST=true

# Delivery validation
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OSRM_BASE_URL=https://router.project-osrm.org
OSM_USER_AGENT=BarHaNoiDelivery/1.0 (https://barhanoi.pl)
