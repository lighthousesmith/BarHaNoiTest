{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "barhanoi",
  "account_id": "8828c0c4765ceb41f86f1f8dda122643",
  "main": "./src/worker.ts",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "barhanoi.pl",
      "custom_domain": true
    },
    {
      "pattern": "www.barhanoi.pl",
      "custom_domain": true
    }
  ],
  "r2_buckets": [
    {
      "bucket_name": "bar-ha-noi-bucket",
      "binding": "bar_ha_noi_bucket"
    }
  ]
}
